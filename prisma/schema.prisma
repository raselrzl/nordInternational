model PollQuestion {
  id        Int          @id @default(autoincrement())
  question  String
  createdAt DateTime     @default(now())
  answers   PollAnswer[]
}

model PollAnswer {
  id             Int      @id @default(autoincrement())
  pollQuestionId Int
  answer         String
  createdAt      DateTime @default(now())

  pollQuestion PollQuestion @relation(fields: [pollQuestionId], references: [id])
}

model AdvertisementPackage {
  id         String   @id
  name       String
  page       String
  dailyPrice Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model PublicSourceNews {
  id           String @id @default(uuid())
  headings     String
  sourceIdName String
  link         Link   @default(INSTAGRAM)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  newsPicture        String?
  newsDetails        String?
}

enum Link {
  FACEBOOK
  INSTAGRAM
  TWITTER
}

model InstagramPost {
  id        String       @id @default(uuid())
  igLink    String
  igStatus  igPostStatus @default(DRAFT)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

enum igPostStatus {
  ACTIVE
  DRAFT
  EXPIRED
}


model NewUserVisit {
  id        Int      @id @default(autoincrement())
  userId    String   @unique
  userAgent String
  language  String?
  platform  String?
  screen    String?
  
  ipAddress     String?
  country       String?
  region        String?
  city          String?
  visits        Int?     @default(1)   // how many times user came
  lastVisit     DateTime?              // last session time
  totalReadTime Int?     @default(0)   // total seconds reading pages
  sessionTime   Int?     @default(0)   // last session duration in seconds

  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}